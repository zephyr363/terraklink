# Copy to .env.production on the VPS. Never commit the filled file.
SITE_DOMAIN=site.example.kz
ACME_EMAIL=ops@example.kz
DJANGO_DEBUG=0
DJANGO_SECRET_KEY=replace-with-a-random-secret-at-least-50-characters-long
DJANGO_ALLOWED_HOSTS=site.example.kz,127.0.0.1,backend
CSRF_TRUSTED_ORIGINS=https://site.example.kz
DJANGO_HSTS_SECONDS=3600
# Opt in only after all subdomains support HTTPS and preload is approved.
DJANGO_HSTS_INCLUDE_SUBDOMAINS=0
DJANGO_HSTS_PRELOAD=0
POSTGRES_DB=terraklink
POSTGRES_USER=terraklink
POSTGRES_PASSWORD=replace-postgres-password
MINIO_ROOT_USER=terraklink-storage
MINIO_ROOT_PASSWORD=replace-minio-password
S3_BUCKET=terraklink
S3_PUBLIC_DOMAIN=site.example.kz/storage/terraklink
MAX_IMAGE_UPLOAD_MB=10
MAX_VIDEO_UPLOAD_MB=50
